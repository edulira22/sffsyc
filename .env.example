# =============================================================================
#  SFFSyC — Variables de entorno
#  Copia este archivo a ".env" y completa los valores reales.
#  NUNCA subas el archivo ".env" al repositorio (ya está en .gitignore).
# =============================================================================

# --- Base de datos (Supabase / PostgreSQL) ------------------------------------
# DATABASE_URL: Transaction pooler (puerto 6543) — úsalo en la app y en Vercel.
# DIRECT_URL:   Conexión directa (puerto 5432)   — necesaria para migraciones Prisma.
#
# Supabase: Settings → Database → Connect → ORM
#   Transaction pooler → URI  →  DATABASE_URL
#   Direct connection  → URI  →  DIRECT_URL
DATABASE_URL="postgresql://postgres.[ref]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[ref].supabase.co:5432/postgres"

# --- Autenticación (NextAuth.js v5) ------------------------------------------
# Secreto para firmar las sesiones. Genera uno nuevo con:
#   npx auth secret      (o)    openssl rand -base64 32
AUTH_SECRET="GENERAR_UN_SECRETO_ALEATORIO"

# URL base de la aplicación. En local: http://localhost:3000
# En el servidor del DIF: la URL interna o el dominio institucional.
AUTH_URL="http://localhost:3000"

# --- Identidad del sistema (público) -----------------------------------------
NEXT_PUBLIC_NOMBRE_SISTEMA="SFFSyC"
NEXT_PUBLIC_NOMBRE_DEPENDENCIA="Subdirección de Fortalecimiento Familiar, Social y Comunitario"

# --- Oficios: lectura con IA (Claude) ----------------------------------------
# Sin esta clave el módulo funciona igual, con captura manual.
# Créala en https://console.anthropic.com → API Keys. Es secreta: nunca la subas.
ANTHROPIC_API_KEY=""
# Opcionales. Modelo (por defecto claude-opus-5-5; claude-haiku-5-5 cuesta ~40 veces menos),
# esfuerzo (low | medium | high) y tope de gasto mensual en dólares.
# OFICIOS_MODELO="claude-opus-5-5"
# OFICIOS_ESFUERZO="low"
# OFICIOS_TOPE_MENSUAL_USD="15"
